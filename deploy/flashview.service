[Unit]
Description=FlashView streaming server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sma
Group=sma
WorkingDirectory=/home/sma/flashview/backend
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/home/sma/flashview/backend/.env
ExecStart=/home/sma/flashview/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 1
Restart=on-failure
RestartSec=3

# Harden the service
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

# Keep background scanning from starving streaming on the Pi's slow CPU
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
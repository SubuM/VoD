# Directory that holds your movie files (mounted USB drive path)
MEDIA_DIR=/media/usb/movies

# Folder where cached posters/backdrops and the database are stored
DATA_DIR=./data

# Comma-separated list of extra directories to scan
EXTRA_MEDIA_DIRS=

# Port the API + frontend server listens on
PORT=8000

# Set to "false" to disable auto-rescan while videos are playing
AUTO_RESCAN=true